# ContractIQ environment configuration (copy to .env and adjust as needed)
# All paths are resolved relative to the project root when left relative.
# NEVER commit the real .env file.

# ---- Backend ----
# SQLite database (project-relative by default; use an absolute path for a custom location)
DATABASE_URL=sqlite:///./data/contractiq.db

# Directory for temporary/retained uploaded files (project-relative)
UPLOAD_DIR=./data/uploads
# How long (hours) to retain raw uploaded documents; 0 = delete right after analysis
UPLOAD_RETENTION_HOURS=24

# Max upload size in megabytes
MAX_UPLOAD_MB=20

# Allowed CORS origins for the frontend (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend port
BACKEND_PORT=8000

# ---- ContractIQ backend (Phase 4/5) ----
# SQLite database (project-relative by default; absolute path also allowed)
CONTRACTIQ_DB_URL=
# Storage directories (project-relative by default)
CONTRACTIQ_UPLOAD_DIR=./storage/uploads
CONTRACTIQ_TEMP_DIR=./storage/temp
# Max upload size in megabytes
CONTRACTIQ_MAX_UPLOAD_MB=20
# Store raw contract text (needed for evidence highlighting; false = metadata only)
CONTRACTIQ_STORE_RAW_TEXT=true
# Hours before temp files are cleaned up
CONTRACTIQ_UPLOAD_RETENTION_HOURS=24
# CORS origins for the API (comma-separated)
CONTRACTIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Minimum ML confidence for a risk rule to score (findings below are "uncertain")
CONTRACTIQ_RISK_MIN_CONFIDENCE=0.5

# ---- ML / models ----
# Local directory for the QA model (project-relative). If empty on first run,
# the backend downloads the configured baseline model automatically.
MODEL_DIR=./ml/models/baseline
# Hugging Face model id used for the automatic first-run download
MODEL_NAME=distilbert-base-uncased
# Where Hugging Face caches downloads (empty = default user cache)
HF_HOME=

# ---- Frontend ----
# Base URL of the backend API (used by the frontend dev server proxy)
VITE_API_BASE_URL=http://localhost:8000
